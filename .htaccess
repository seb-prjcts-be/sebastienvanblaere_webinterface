RewriteEngine On

# === Hardening ===
# Disable directory listing (geen index.html → 403 i.p.v. file-tree)
Options -Indexes

# Block toegang tot dotfiles (.git/, .env, .htaccess zelf, .DS_Store, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Block markdown-docs (cloud.md, MEMORY.md, README's, STARTERs)
<FilesMatch "\.md$">
    Require all denied
</FilesMatch>

# Security headers (vereist mod_headers — standaard op Apache)
<IfModule mod_headers.c>
    # Geen MIME-sniffing → forceer Content-Type-respect
    Header always set X-Content-Type-Options "nosniff"
    # Clickjacking-defence: enkel zelfde origin mag in iframe
    Header always set X-Frame-Options "SAMEORIGIN"
    # Referer-info beperken bij cross-origin navigatie
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # FLoC / topics opt-out
    Header always set Permissions-Policy "interest-cohort=(), browsing-topics=()"
    # HSTS — alleen sturen op HTTPS-verbindingen
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
</IfModule>

# === SEO: Canonieke non-www redirect (301) & Sitemap routing ===
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

RewriteRule ^sitemap\.xml$ sitemap.php [L,QSA]

# === Host-based routing voor productie ===
# prjcts.be             → sites/prjcts/
# kunstmijnoren.be      → sites/kunstmijnoren/

RewriteCond %{HTTP_HOST} ^(www\.)?prjcts\.be$ [NC]
RewriteCond %{REQUEST_URI} !^/sites/
RewriteCond %{REQUEST_URI} !^/_shared/
RewriteRule ^(.*)$ sites/prjcts/$1 [L]

RewriteCond %{HTTP_HOST} ^(www\.)?kunstmijnoren\.be$ [NC]
RewriteCond %{REQUEST_URI} !^/sites/
RewriteCond %{REQUEST_URI} !^/_shared/
RewriteRule ^(.*)$ sites/kunstmijnoren/$1 [L]

# === Core Web Vitals: Compressie & Browser Caching ===
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 hour"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/xml "access plus 1 hour"
    ExpiresByType application/json "access plus 1 hour"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
